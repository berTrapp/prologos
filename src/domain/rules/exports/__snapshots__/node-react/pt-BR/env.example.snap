# Agenda de aulas — variáveis de ambiente
# Gerado pelo Prólogos. Segredos ficam em branco: preencha só no seu .env, que não vai para o repositório.

# Front (vai para o navegador: nada secreto aqui)
VITE_API_URL=http://localhost:3000/api

# Back-end (fica no servidor)
PORT=3000
DATABASE_URL=
AUTH_SECRET=

# Docker (lidas pelo docker-compose.yml)
DB_USER=app
DB_NAME=agenda_de_aulas
DB_PASSWORD=
