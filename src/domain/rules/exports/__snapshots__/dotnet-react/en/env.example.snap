# Agenda de aulas — environment variables
# Generated by Prólogos. Secrets stay blank: fill them in only in your .env, which never goes to the repository.

# Front end (goes to the browser: nothing secret here)
VITE_API_URL=http://localhost:5000/api

# API (stays on the server)
ASPNETCORE_ENVIRONMENT=Development
CONNECTIONSTRINGS__DEFAULT=
JWT__KEY=

# Docker (read by docker-compose.yml)
DB_USER=app
DB_NAME=agenda_de_aulas
DB_PASSWORD=
