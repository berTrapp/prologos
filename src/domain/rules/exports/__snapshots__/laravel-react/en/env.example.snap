# Agenda de aulas — environment variables
# Generated by Prólogos. Secrets stay blank: fill them in only in your .env, which never goes to the repository.

# Front end (goes to the browser: nothing secret here)
VITE_API_URL=http://localhost:8000/api

# Back end (stays on the server)
APP_KEY=
APP_ENV=local
APP_URL=http://localhost:8000
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_DATABASE=meu_projeto
DB_USERNAME=sail
DB_PASSWORD=
